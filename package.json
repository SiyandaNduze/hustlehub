{
  "name": "hustlehub",
  "version": "3.0.0",
  "description": "HustleHub+ - secure freelance marketplace (final: tax dashboard, DevSecOps, monitoring)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:demo": "node scripts/seedDemo.js",
    "lint": "eslint . --max-warnings 0",
    "lint:report": "eslint . --max-warnings 0 --output-file reports/eslint-report.txt",
    "test:unit": "node --test tests/unit/tax.test.js tests/unit/ledger.test.js tests/unit/logger.test.js tests/unit/loginAttempts.test.js tests/unit/sanitize.test.js tests/unit/jsonStore.test.js",
    "test:api": "newman run postman/HustleHub.postman_collection.json --insecure -r cli,htmlextra --reporter-htmlextra-export reports/newman-report.html",
    "test:api:docker": "newman run postman/HustleHub.postman_collection.json --insecure --env-var baseUrl=https://localhost:8443/api -r cli,htmlextra --reporter-htmlextra-export reports/newman-docker-report.html",
    "test:ratelimit": "node scripts/rateLimitCheck.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "client:install": "npm --prefix client install",
    "client:build": "npm --prefix client run build",
    "test:client": "npm --prefix client test",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^17.14.0",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
